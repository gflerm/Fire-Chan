EMBER_TOKEN=replace-with-a-long-random-value
EMBER_HOST=0.0.0.0
EMBER_PORT=8088
EMBER_AUDIO_DIR=/var/lib/ember/audio
EMBER_MAX_UPLOAD_MB=12
EMBER_TIMEZONE=Africa/Johannesburg
WHISPER_URL=http://127.0.0.1:8080
LLM_PROVIDER=ollama
LLM_FALLBACK_TO_OLLAMA=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash-lite
PIPER_URL=http://127.0.0.1:5000
# Reply audio sample rate in Hz. 0 = Piper native (22050, no resample).
# 8000/16000 shrink/download reply audio (and make streaming-viable); test quality.
EMBER_AUDIO_RATE_HZ=0
SESSION_MAX_TURNS=6
SESSION_IDLE_SECONDS=1800
# Weather location (Open-Meteo). Lat/lon 0,0 disables weather answers.
EMBER_WEATHER_LAT=-33.9249
EMBER_WEATHER_LON=18.4241
EMBER_WEATHER_PLACE=Cape Town
