[Unit]
Description=Ember Piper speech synthesis
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ember
Group=ember
WorkingDirectory=/opt/ember/models/piper
ExecStart=/opt/ember/venv/bin/python -m piper.http_server -m en_GB-alba-medium --data-dir /opt/ember/models/piper --host 127.0.0.1 --port 5000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
